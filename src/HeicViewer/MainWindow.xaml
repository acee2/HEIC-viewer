<Window x:Class="HeicViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HEIC Viewer"
        Icon="Assets/app.ico"
        Width="1100" Height="760" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F9FC"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= Barra in alto ======================= -->
        <Border x:Name="TopBar" Grid.Row="0" Height="34" BorderBrush="#FFB9CDE5" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF3F8FD" Offset="0" />
                    <GradientStop Color="#FFDCE8F5" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="True" Margin="6,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="FileMenuButton" Style="{StaticResource TopButton}" Click="OnFileMenu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="File" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9" Margin="6,2,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="FileMenu">
                                <MenuItem Header="Apri..." InputGestureText="Ctrl+O" Click="OnOpen" />
                                <MenuItem x:Name="MenuShowInFolder" Header="Mostra nella cartella" Click="OnShowInFolder" />
                                <MenuItem x:Name="MenuCopy" Header="Copia" InputGestureText="Ctrl+C" Click="OnCopy" />
                                <MenuItem x:Name="MenuDelete" Header="Elimina" InputGestureText="Canc" Click="OnDelete" />
                                <Separator />
                                <MenuItem Header="Usa come app predefinita..." Click="OnDefaultApps" />
                                <Separator />
                                <MenuItem Header="Esci" Click="OnExit" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TopButton}" Click="OnShowInFolder" x:Name="TopShowInFolder">
                        <TextBlock Text="Apri percorso file" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="InfoText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#FF4A6684"
                           Margin="0,0,6,0" FontSize="12" />
                <TextBlock x:Name="NameText" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#FF1E3A5F" FontSize="12" TextTrimming="CharacterEllipsis" Margin="12,0" />
            </DockPanel>
        </Border>

        <!-- ======================= Contenuto ======================= -->
        <Grid x:Name="ContentArea" Grid.Row="1">
            <!-- Foto -->
            <Grid x:Name="ImageHost" ClipToBounds="True" Background="Transparent"
                  MouseWheel="OnImageWheel"
                  MouseLeftButtonDown="OnImageMouseDown"
                  MouseLeftButtonUp="OnImageMouseUp"
                  MouseMove="OnImageMouseMove"
                  SizeChanged="OnImageHostSizeChanged">
                <Image x:Name="Photo" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>

            <!-- Video (il VideoView viene creato al primo video) -->
            <Border x:Name="VideoHost" Background="Black" Visibility="Collapsed" />

            <!-- Messaggi (caricamento, errori, nessun file) -->
            <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="MessageText" FontSize="15" Foreground="#FF4A6684" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
                <Button x:Name="MessageOpenButton" Content="Apri una foto o un video..." Margin="0,14,0,0" Padding="14,6"
                        HorizontalAlignment="Center" Click="OnOpen" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- ======================= Barra in basso: FOTO ======================= -->
        <Border x:Name="ImageBar" Grid.Row="2" Height="62" BorderBrush="#FFB9CDE5" BorderThickness="0,1,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFE8F1FB" Offset="0" />
                    <GradientStop Color="#FFCFDFF0" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource BarButton}" Content="&#xE71F;" ToolTip="Riduci (-)" Click="OnZoomOut" />
                <Button Style="{StaticResource BarButton}" Content="&#xE8A3;" ToolTip="Ingrandisci (+)" Click="OnZoomIn" />
                <Button x:Name="FitButton" Style="{StaticResource BarButton}" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                        Content="1:1" ToolTip="Dimensioni effettive / Adatta alla finestra (0)" Click="OnToggleFit" />
                <Rectangle Width="1" Height="30" Fill="#FFAFC6E0" Margin="10,0" />
                <Button x:Name="PrevButton" Style="{StaticResource BarButton}" Content="&#xE892;" ToolTip="Precedente (freccia sinistra)" Click="OnPrevious" />
                <Button x:Name="SlideshowButton" Style="{StaticResource BigButton}" Content="&#xE768;" ToolTip="Presentazione (F11)" Click="OnSlideshow" />
                <Button x:Name="NextButton" Style="{StaticResource BarButton}" Content="&#xE893;" ToolTip="Successiva (freccia destra)" Click="OnNext" />
                <Rectangle Width="1" Height="30" Fill="#FFAFC6E0" Margin="10,0" />
                <Button Style="{StaticResource BarButton}" ToolTip="Ruota in senso antiorario (Ctrl+,)" Click="OnRotateLeft">
                    <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource Icons}" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform><ScaleTransform ScaleX="-1" /></TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource BarButton}" Content="&#xE7AD;" ToolTip="Ruota in senso orario (Ctrl+.)" Click="OnRotateRight" />
                <Rectangle Width="1" Height="30" Fill="#FFAFC6E0" Margin="10,0" />
                <Button Style="{StaticResource BarButton}" Content="&#xE74D;" Foreground="#FFC0392B" ToolTip="Elimina (Canc)" Click="OnDelete" />
            </StackPanel>
        </Border>

        <!-- ======================= Barra in basso: VIDEO ======================= -->
        <Border x:Name="VideoBar" Grid.Row="2" Visibility="Collapsed" Padding="12,6,12,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF2B2B2B" Offset="0" />
                    <GradientStop Color="#FF151515" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock x:Name="TimeText" DockPanel.Dock="Left" Foreground="#FFDDDDDD" FontSize="12" Width="56" VerticalAlignment="Center" Text="0:00" />
                    <TextBlock x:Name="DurationText" DockPanel.Dock="Right" Foreground="#FFDDDDDD" FontSize="12" Width="56" TextAlignment="Right" VerticalAlignment="Center" Text="0:00" />
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" VerticalAlignment="Center" Focusable="False"
                            PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource DarkBarButton}" Content="&#xE71A;" ToolTip="Stop" Click="OnStop" />
                        <Button Style="{StaticResource DarkBarButton}" Content="&#xE892;" ToolTip="Precedente" Click="OnPrevious" />
                        <Button x:Name="PlayButton" Style="{StaticResource BigButton}" Content="&#xE769;" ToolTip="Riproduci / Pausa (Spazio)" Click="OnPlayPause" />
                        <Button Style="{StaticResource DarkBarButton}" Content="&#xE893;" ToolTip="Successivo" Click="OnNext" />
                        <Button Style="{StaticResource DarkBarButton}" Content="&#xE74D;" Foreground="#FFE57373" ToolTip="Elimina (Canc)" Click="OnDelete" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Style="{StaticResource DarkBarButton}" Content="&#xE767;" ToolTip="Audio" Click="OnMute" />
                        <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center"
                                IsMoveToPointEnabled="True" Focusable="False" ValueChanged="OnVolumeChanged" />
                        <Button x:Name="FullScreenButton" Style="{StaticResource DarkBarButton}" Content="&#xE740;" ToolTip="Schermo intero (F11)" Click="OnToggleFullScreen" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
